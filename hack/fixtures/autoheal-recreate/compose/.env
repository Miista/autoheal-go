# The scenario's constants, read by compose when it brings the stack up and by
# the test when it works out what to expect.
#
# How many heal attempts without recovery autoheal tolerates before giving up.
# Low on purpose, and lower-feeling than it looks: a recreate is a whole
# stop/remove/create/start through compose, several times slower than the
# restart the other crash-loop scenario counts.
CRASHLOOP_STRIKES=2
